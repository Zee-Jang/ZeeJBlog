DATABASE_URL=sqlite:///./blog.db
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-me-on-first-boot
ADMIN_NAME=Zeej
DEFAULT_INVITE_CODE=ZEEJ-WELCOME
# 仅本地开发可 true：启动时写入上面的默认邀请码。上线务必 false
SEED_DEFAULT_INVITE=false

# 本地开发可设 true：验证码打印到终端，并在接口响应中回传
# 上线务必保持 false（且配置好 SMTP）
MAIL_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# 可选：项目「从远程导入」
GITHUB_TOKEN=
GITEE_TOKEN=

# DeepSeek 站内机器人（密钥只放本机 .env，勿提交仓库）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
BOT_EMAIL=bot@zeej.local
BOT_NAME=Zeej Bot
BOT_BIO=站内助手 · 多轮对话 · 可随时清除本轮记录
BOT_HISTORY_LIMIT=30
